                                            ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="MicrophoneGainValue" Grid.Column="3" TextAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="#403A45" />
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="マイク感度" FontWeight="SemiBold" />
                                    <CheckBox x:Name="MicSensitivityCheck" Grid.Column="1" Style="{StaticResource OverlaySwitchStyle}"
