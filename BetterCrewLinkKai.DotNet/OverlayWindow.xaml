<Window x:Class="BetterCrewLinkKai.DotNet.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterCrewLinkKai.net Overlay"
        Width="300"
        MinHeight="76"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
            Background="{Binding OverlayPanelBackground}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="OverlayPanel"
            Background="{Binding OverlayPanelBackground}"
            Padding="{Binding OverlayPanelPadding}">
        <StackPanel Orientation="{Binding OverlayItemsOrientation}"
                    HorizontalAlignment="{Binding OverlayItemsAlignment}">
            <Grid Margin="{Binding OverlayLocalItemMargin}"
                  Visibility="{Binding IsLocalVisibleInGameOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding OverlayFirstColumnWidth}" />
                    <ColumnDefinition Width="{Binding OverlaySecondColumnWidth}" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="{Binding OverlayNameColumn}"
                        Background="#B0121018"
                        CornerRadius="11"
                        Padding="7,2"
                        MaxWidth="116"
                        HorizontalAlignment="{Binding OverlayNameAlignment}"
                        VerticalAlignment="Center"
                        Visibility="{Binding OverlaySideNameVisibility}">
                    <TextBlock Text="{Binding LocalPlayerName}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="2"
                                              ShadowDepth="1"
                                              Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <Grid Grid.Column="{Binding OverlayAvatarColumn}"
                      Width="68"
                      Height="68"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Ellipse Width="64"
                             Height="64"
                             Stroke="{Binding LocalRingBrush}"
                             StrokeThickness="{Binding LocalRingThickness}"
                             Fill="#25232A"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#32FF7E"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0" />
                        </Ellipse.Effect>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalIsTalking}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                     To="5"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                     To="2"
                                                                     Duration="0:0:0.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <Grid Width="64"
                          Height="64"
                          ClipToBounds="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.Clip>
                            <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" />
                        </Grid.Clip>
                        <Viewbox Width="64"
                                 Height="64"
                                 Stretch="Fill">
                            <Grid Width="78" Height="78">
                                <Image Source="{Binding LocalHatBackImage}"
                                       Width="{Binding LocalHatWidth}"
                                       Margin="{Binding LocalHatMargin}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="2" ScaleY="2" />
                                            <TranslateTransform X="12" Y="-22" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <Image Source="{Binding LocalAvatarImage}"
                                       Width="78"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />
                                <Image Source="{Binding LocalSkinImage}"
                                       Width="{Binding LocalSkinWidth}"
                                       Margin="{Binding LocalSkinMargin}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="2" ScaleY="2" />
                                            <TranslateTransform X="12" Y="-22" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <Image Source="{Binding LocalVisorImage}"
                                       Width="{Binding LocalVisorWidth}"
                                       Margin="{Binding LocalVisorMargin}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />
                                <Image Source="{Binding LocalHatFrontImage}"
                                       Width="{Binding LocalHatWidth}"
                                       Margin="{Binding LocalHatMargin}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="2" ScaleY="2" />
                                            <TranslateTransform X="12" Y="-22" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Viewbox>
                    </Grid>
                    <Border Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="#E52525"
                            BorderBrush="White"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsMuteBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Viewbox Width="20" Height="20">
                            <Grid Width="24" Height="24">
                                <Path Fill="White"
                                      Data="M12 14C13.66 14 15 12.66 15 11V5C15 3.34 13.66 2 12 2S9 3.34 9 5V11C9 12.66 10.34 14 12 14ZM17.3 11C17.3 14 14.76 16.1 12 16.1S6.7 14 6.7 11H5C5 14.41 7.72 17.23 11 17.72V21H13V17.72C16.28 17.24 19 14.42 19 11H17.3Z" />
                                <Line X1="5"
                                      Y1="5"
                                      X2="19"
                                      Y2="19"
                                      Stroke="White"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <Border Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="#E52525"
                            BorderBrush="White"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDeafenBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Viewbox Width="20" Height="20">
                            <Grid Width="24" Height="24">
                                <Path Fill="White"
                                      Data="M3 9V15H7L12 20V4L7 9H3ZM16.5 12C16.5 10.23 15.5 8.71 14 7.97V16.02C15.48 15.29 16.5 13.76 16.5 12ZM14 3.23V5.29C16.89 6.15 19 8.83 19 12S16.89 17.85 14 18.71V20.77C18.01 19.86 21 16.28 21 12S18.01 4.14 14 3.23Z" />
                                <Line X1="5"
                                      Y1="5"
                                      X2="19"
                                      Y2="19"
                                      Stroke="White"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </Border>
                </Grid>

            </Grid>

            <ItemsControl ItemsSource="{Binding OtherPlayers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DataContext.OverlayItemsOrientation, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="{Binding DataContext.OverlayItemsAlignment, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                    <Grid Margin="{Binding DataContext.OverlayPlayerItemMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                          Opacity="{Binding Opacity}"
                          Visibility="{Binding IsVisibleInGameOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding DataContext.OverlayFirstColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.OverlaySecondColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="{Binding DataContext.OverlayNameColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#B0121018"
                                CornerRadius="11"
                                Padding="7,2"
                                MaxWidth="116"
                                HorizontalAlignment="{Binding DataContext.OverlayNameAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.OverlaySideNameVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black"
                                                      BlurRadius="2"
                                                      ShadowDepth="1"
                                                      Opacity="0.8" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>

                        <Grid Grid.Column="{Binding DataContext.OverlayAvatarColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                              Width="68"
                              Height="68"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Width="64"
                                     Height="64"
                                     Stroke="{Binding RingBrush}"
                                     StrokeThickness="{Binding RingThickness}"
                                     Fill="#25232A"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#32FF7E"
                                                      BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0" />
                                </Ellipse.Effect>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTalking}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                             To="5"
                                                                             Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                             To="2"
                                                                             Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <Grid Width="64"
                                  Height="64"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Grid.Clip>
                                    <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" />
                                </Grid.Clip>
                                <Viewbox Width="64"
                                         Height="64"
                                         Stretch="Fill">
                                    <Grid Width="38" Height="38">
                                        <Image Source="{Binding HatBackImage}"
                                               Width="{Binding HatWidth}"
                                               Margin="{Binding HatMargin}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="2" ScaleY="2" />
                                                    <TranslateTransform X="6" Y="-11" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Image Source="{Binding AvatarImage}"
                                               Width="38"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top" />
                                        <Image Source="{Binding SkinImage}"
                                               Width="{Binding SkinWidth}"
                                               Margin="{Binding SkinMargin}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="2" ScaleY="2" />
                                                    <TranslateTransform X="6" Y="-11" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Image Source="{Binding VisorImage}"
                                               Width="{Binding VisorWidth}"
                                               Margin="{Binding VisorMargin}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top" />
                                        <Image Source="{Binding HatFrontImage}"
                                               Width="{Binding HatWidth}"
                                               Margin="{Binding HatMargin}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="2" ScaleY="2" />
                                                    <TranslateTransform X="6" Y="-11" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{Binding ConnectionWarningBackground}"
                                    BorderBrush="{Binding ConnectionWarningBorder}"
                                    BorderThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="2"
                                    ToolTip="{Binding ConnectionWarningText}"
                                    Visibility="{Binding ConnectionWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White"
                                              Data="{Binding ConnectionWarningIconPath}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                    </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
