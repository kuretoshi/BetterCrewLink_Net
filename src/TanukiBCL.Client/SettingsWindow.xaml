                            <TextBlock Text="【MOD】TOH4E／TOH4E_EM設定" FontWeight="SemiBold"
                                       Foreground="#C779D7" Margin="0,0,0,14" />
                            <CheckBox x:Name="TohNeutralKillerHauntingCheck"
                                      Content="第三陣営・アニマル陣営のキルできる役職が幽霊の声も聞こえる"
                                      Margin="0,0,0,14" />
                        </StackPanel>
                        <StackPanel x:Name="NosControlsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="【MOD】NoS設定" FontWeight="SemiBold" Foreground="#C779D7"
                                       Margin="0,0,0,14" />
                            <CheckBox x:Name="JackalRadioCheck" Content="ジャッカルラジオ" Margin="0,0,0,14"
                                      Checked="JackalRadioCheck_Changed" Unchecked="JackalRadioCheck_Changed" />
                            <CheckBox x:Name="NosNeutralKillerHauntingCheck"
                                      Content="第三陣営のキルできる役職が幽霊の声も聞こえる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="NosVoicePositionsCheck" Margin="0,0,0,14">
                                <TextBlock Text="プレイヤーらのスピーカー位置(話している位置)と、自身のマイク位置(収音する位置)をNoSのデータに含まれている座標に変更" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox x:Name="NosSizeVoiceEffectCheck" Content="大きさが変化した場合にエフェクトをかける"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="NosFixerJammingVoiceBlockCheck" Content="フィクサーの妨害を受けた際に音声を遮断する"
                                      Margin="0,0,0,14" />
                        </StackPanel>
                        <StackPanel Margin="0,24,0,0">
                            <TextBlock Text="公開ロビー" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,8" />
                            <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1"
                                    CornerRadius="8" Padding="16,10">
                                <StackPanel>
                                    <CheckBox x:Name="PublicLobbyOnCheck" Content="ロビーを公開する"
                                              Style="{StaticResource OverlaySwitchStyle}" />
                                    <TextBlock Text="これを有効にすると、あなたのロビーは他のBetterCrewLinkKaiユーザーに公開されます！"
                                               Foreground="#B7AABD" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <Separator Background="#3F3944" Margin="0,0,0,12" />
                                    <TextBlock Text="タイトル" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="不適切な表現を使った場合、BetterCrewLinkKaiからBANされます。"
                                               Foreground="#B7AABD" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBox x:Name="PublicLobbyTitleBox" Background="#25232A" Foreground="#F5F1F7"
                                             BorderBrush="#5A515D" Margin="0,0,0,12" />
                                    <TextBlock Text="言語" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="PublicLobbyLanguageCombo" Style="{StaticResource DarkAudioComboStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PlayersPanel" Visibility="Collapsed">
                        <TextBlock Text="プレイヤー" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
