                            <StackPanel>
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="マイク音量" FontWeight="SemiBold" />
                                    <CheckBox x:Name="MicrophoneGainCheck" Grid.Column="1" Style="{StaticResource OverlaySwitchStyle}"
