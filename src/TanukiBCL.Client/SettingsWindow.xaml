                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DistanceTitleText" Text="ボイスの距離" FontSize="14"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Slider x:Name="DistanceSlider" Grid.Column="1" Minimum="1" Maximum="10"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            ValueChanged="VolumeSlider_ValueChanged" Margin="0,0,12,0"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="DistanceValue" Grid.Column="2" TextAlignment="Right" />
                                </Grid>
                                <CheckBox x:Name="WallsBlockAudioCheck" Content="壁越しで音声をブロック"
