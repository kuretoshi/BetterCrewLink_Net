<Window x:Class="TanukiBCL.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TanukiBCL.Client"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="設定" Width="750" Height="630" MinWidth="620" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#1D1B22" Foreground="#F5F1F7" WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F1F7" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F1F7" />
        </Style>
        <Style x:Key="AudioModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" MinHeight="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="20" Height="20" Margin="0,0,8,0">
                                    <Ellipse x:Name="OuterRing" Width="16" Height="16"
                                             Stroke="#B8AFBC" StrokeThickness="2" />
                                    <Ellipse x:Name="SelectedDot" Width="8" Height="8"
                                             Fill="#BA68C8" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#BA68C8" />
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AudioLevelBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#5A2020" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                CornerRadius="4" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="214" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BA68C8" />
            <Setter Property="BorderBrush" Value="#68466F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#47434A" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#47434A" />
                                <Setter Property="Foreground" Value="#77727B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateFilledButtonStyle" TargetType="Button"
               BasedOn="{StaticResource UpdateActionButtonStyle}">
            <Setter Property="Background" Value="#BA68C8" />
            <Setter Property="Foreground" Value="#1D1B22" />
            <Setter Property="BorderBrush" Value="#BA68C8" />
        </Style>
        <Style x:Key="ResetDangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#F44336" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D32F2F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#C62828" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#49464C" />
                                <Setter Property="Foreground" Value="#918C95" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
        </Style>
        <Style x:Key="DarkAudioComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#25232A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#5A515D" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="#25232A" />
                        <Setter Property="Padding" Value="8,6" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#49374E" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="10,0,2,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path Grid.Column="1" Data="M7 10l5 5 5-5z" Fill="White"
                                          Width="20" Height="20" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#25232A" BorderBrush="#5A515D" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="OverlaySwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="36" Height="20"
                                    CornerRadius="10" Background="#68646B" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#AE70BB" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LobbySwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" BorderBrush="#3B3540"
                                BorderThickness="0,0,0,1" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="SwitchTrack" Grid.Column="1" Width="36" Height="20"
                                        CornerRadius="10" Background="#68646B" VerticalAlignment="Center">
                                    <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White"
                                             HorizontalAlignment="Left" Margin="2,0,0,0" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#AE70BB" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LobbyTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#BA68C8" />
                                <Setter Property="Foreground" Value="#BA68C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LobbyHostEditButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#BA68C8" />
            <Setter Property="Foreground" Value="#1D1B22" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShortcutFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Source Code Pro" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#1E1A22" />
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="BorderBrush" Value="#57515B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="ShortcutBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Visibility="Collapsed" />
                                <TextBlock x:Name="ShortcutValue" Text="{TemplateBinding Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="Source Code Pro" FontSize="13" FontWeight="Bold" />
                                <StackPanel x:Name="RecordingPrompt" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False" Visibility="Collapsed">
                                    <Path Data="{DynamicResource KeyboardIcon}" Fill="#CE93D8"
                                          Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="{TemplateBinding ToolTip}" Foreground="#CE93D8"
                                               FontFamily="Source Code Pro" FontSize="13" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Recording">
                                <Setter TargetName="ShortcutValue" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="RecordingPrompt" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ShortcutBorder" Property="Background" Value="#392B40" />
                                <Setter TargetName="ShortcutBorder" Property="BorderBrush" Value="#CE93D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
