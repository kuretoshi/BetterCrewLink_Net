        <Geometry x:Key="VideoIcon">M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11z</Geometry>
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="8,2" Padding="12,8">
                            <DockPanel LastChildFill="True">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0" DockPanel.Dock="Left">
                                    <Path x:Name="NavIcon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Fill="#AAA5AD" Width="24" Height="24" Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#302A35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#423348" />
                                <Setter TargetName="NavIcon" Property="Fill" Value="#CE93D8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#1D1A23" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="10,0,70,0" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.61-.22l-2.39.96a7.3 7.3 0 0 0-1.63-.94L14.37 2.8a.49.49 0 0 0-.49-.4h-3.76a.49.49 0 0 0-.49.4L9.27 5.3c-.59.23-1.14.54-1.63.94l-2.39-.96a.49.49 0 0 0-.61.22L2.72 8.82a.49.49 0 0 0 .12.64l2.03 1.58a6.8 6.8 0 0 0 0 1.88l-2.03 1.58a.49.49 0 0 0-.12.64l1.92 3.32c.12.21.37.29.61.22l2.39-.96c.49.4 1.04.71 1.63.94l.36 2.5c.04.24.24.4.49.4h3.76c.25 0 .45-.16.49-.4l.36-2.5c.59-.23 1.14-.54 1.63-.94l2.39.96c.24.07.49-.01.61-.22l1.92-3.32a.5.5 0 0 0-.12-.64zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7" Fill="#CE93D8" />
                </Viewbox>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="13" Foreground="#CE93D8" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeSettingsButton" Width="34" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#777" FontSize="16" Content="−"
                        Click="MinimizeSettingsButton_Click" ToolTip="最小化" />
                <Button x:Name="CloseSettingsButton" Width="34" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#777" FontSize="16" Content="×"
                        Click="CloseSettingsButton_Click" ToolTip="閉じる" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="SettingsNavigation" Background="#19171D" BorderBrush="#403146" BorderThickness="0,0,1,0">
            <StackPanel Margin="0">
                <ListBox x:Name="CategoryList" Background="Transparent" Foreground="White"
                         BorderThickness="0"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBoxItem Content="一般" Tag="{StaticResource TuneIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="ロビー設定" Tag="{StaticResource GroupsIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="プレイヤー" Tag="{StaticResource PersonIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="オーディオ" Tag="{StaticResource VolumeIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="キー割り当て" Tag="{StaticResource KeyboardIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="オーバーレイ" Tag="{StaticResource LayersIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="詳細設定" Tag="{StaticResource ScienceIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="アップデート" Tag="{StaticResource UpdateIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="配信設定" Tag="{StaticResource VideoIcon}" Style="{StaticResource CategoryItemStyle}" />
                </ListBox>
            </StackPanel>
        </Border>
        <Grid x:Name="SettingsContent" Grid.Column="1" Margin="26,24,24,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="一般" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,15" />
