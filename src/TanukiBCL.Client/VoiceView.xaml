<UserControl x:Class="TanukiBCL.Client.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TanukiBCL.Client"
             Background="#25232A" Foreground="White">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#25232A">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1D1A23" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="タヌキのベタクル" Foreground="#CE93D8" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="42,0,25,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SettingsButton" Content="⚙" Width="24" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#888" Click="SettingsButton_Click" ToolTip="設定" />
                <Button x:Name="ReloadButton" Content="⟳" Width="24" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#888" Click="ReloadButton_Click" ToolTip="再読み込み" />
            </StackPanel>
            <Button x:Name="CloseButton" Content="×" Width="24" Height="24" Padding="0" BorderThickness="0"
                    HorizontalAlignment="Right" Background="Transparent" Foreground="#888"
                    Click="CloseButton_Click" ToolTip="閉じる" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,8">
            <Grid x:Name="LobbyHeader" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:PlayerAvatar x:Name="LocalAvatar" Grid.Column="0" Width="90" Height="90"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="LocalName" FontSize="20" MaxWidth="115" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                        <Border x:Name="CodeBackground" Background="#3E4346" CornerRadius="5"
                                Padding="5" Margin="0,5,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="LobbyCode" FontSize="28" FontFamily="Consolas"
                                       Text="MENU" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,26,0,0">
                        <Button x:Name="MuteButton" Width="26" Height="26" Padding="0"
                                BorderThickness="0" Background="Transparent" Foreground="White"
                                Click="MuteButton_Click" ToolTip="マイクをミュート">
                            <Viewbox Width="20" Height="20">
                                <Path x:Name="MuteIcon" Fill="White" Stretch="Uniform" Width="24" Height="24"
                                      Data="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3m5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="DeafenButton" Width="26" Height="26" Padding="0"
                                BorderThickness="0" Background="Transparent" Foreground="White"
                                Click="DeafenButton_Click" ToolTip="スピーカーをミュート">
                            <Viewbox Width="20" Height="20">
                                <Path x:Name="DeafenIcon" Fill="White" Stretch="Uniform" Width="24" Height="24"
                                      Data="M3 9v6h4l5 5V4L7 9zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02M14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock x:Name="WarningText" Visibility="Collapsed" TextAlignment="Center" FontSize="11"
                       Foreground="#D7D1DA" Margin="4,4,4,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Background="#5C565F" />

        <Grid Grid.Row="3">
            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Top" Margin="0,20,0,0"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Among Usを待っています" FontSize="20" TextAlignment="Center" />
                <TextBlock Text="ゲームを起動してください" FontSize="17" Margin="0,20,0,0" TextAlignment="Center" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,4,0,0">
                <WrapPanel x:Name="OtherPlayersPanel" Width="225" HorizontalAlignment="Center" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock x:Name="DetectedMod" FontSize="10" Foreground="#B8B5B9" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,6,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button x:Name="GithubButton" Width="72" Height="36" Margin="4,0" ToolTip="GitHubのページはこちら"
                        Background="Transparent" BorderThickness="0" Foreground="#D0D0D0"
                        Click="GithubButton_Click">
                    <Viewbox Width="36" Height="36">
                        <Path Fill="White" Width="24" Height="24" Stretch="Uniform"
                              Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="DiscordButton" Width="72" Height="36" Margin="4,0" ToolTip="サポート用Discord"
                        Background="Transparent" BorderThickness="0" Foreground="#7289DA"
                        Click="DiscordButton_Click">
                    <Viewbox Width="36" Height="36">
                        <Canvas Width="245" Height="240">
                            <Path Fill="#7289DA" Data="M104.4 103.9c-5.7 0-10.2 5-10.2 11.1s4.6 11.1 10.2 11.1c5.7 0 10.2-5 10.2-11.1.1-6.1-4.5-11.1-10.2-11.1zM140.9 103.9c-5.7 0-10.2 5-10.2 11.1s4.6 11.1 10.2 11.1c5.7 0 10.2-5 10.2-11.1s-4.5-11.1-10.2-11.1z" />
                            <Path Fill="#7289DA" Data="M189.5 20h-134C44.2 20 35 29.2 35 40.6v135.2c0 11.4 9.2 20.6 20.5 20.6h113.4l-5.3-18.5 12.8 11.9 12.1 11.2 21.5 19V40.6c0-11.4-9.2-20.6-20.5-20.6zm-38.6 130.6s-3.6-4.3-6.6-8.1c13.1-3.7 18.1-11.9 18.1-11.9-4.1 2.7-8 4.6-11.5 5.9-5 2.1-9.8 3.5-14.5 4.3-9.6 1.8-18.4 1.3-25.9-.1-5.7-1.1-10.6-2.7-14.7-4.3-2.3-.9-4.8-2-7.3-3.4-.3-.2-.6-.3-.9-.5-.2-.1-.3-.2-.4-.3-1.8-1-2.8-1.7-2.8-1.7s4.8 8 17.5 11.8c-3 3.8-6.7 8.3-6.7 8.3-22.1-.7-30.5-15.2-30.5-15.2 0-32.2 14.4-58.3 14.4-58.3 14.4-10.8 28.1-10.5 28.1-10.5l1 1.2c-18 5.2-26.3 13.1-26.3 13.1s2.2-1.2 5.9-2.9c10.7-4.7 19.2-6 22.7-6.3.6-.1 1.1-.2 1.7-.2 6.1-.8 13-1 20.2-.2 9.5 1.1 19.7 3.9 30.1 9.6 0 0-7.9-7.5-24.9-12.7l1.4-1.6s13.7-.3 28.1 10.5c0 0 14.4 26.1 14.4 58.3 0 0-8.5 14.5-30.6 15.2z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="HelpButton" Width="48" Height="36" Margin="4,0" ToolTip="お問い合わせ"
                        Background="Transparent" BorderThickness="0" Foreground="#D0D0D0"
                        Click="HelpButton_Click">
                    <Grid Width="28" Height="28">
                        <Ellipse Fill="White" />
                        <TextBlock Text="?" Foreground="#25232A" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <Popup x:Name="PlayerConfigPopup" Placement="Top" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="Fade" IsOpen="False">
            <Border x:Name="PlayerConfigPopupContent" Background="#353239" BorderBrush="#68616C"
                    BorderThickness="1" CornerRadius="4" Padding="9,6"
                    MouseEnter="PlayerConfigPopup_MouseEnter" MouseLeave="PlayerConfigPopup_MouseLeave">
                <StackPanel>
                    <TextBlock x:Name="PlayerConfigName" TextAlignment="Center" FontWeight="Bold"
                               MaxWidth="175" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                        <Button x:Name="PlayerMuteButton" Width="30" Height="30" Background="Transparent"
                                Click="PlayerMuteButton_Click" ToolTip="このプレイヤーをミュート">
                            <Viewbox Width="20" Height="20">
                                <Path x:Name="PlayerMuteIcon" Fill="#CE93D8" Width="24" Height="24"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>
                        <Slider x:Name="PlayerVolumeSlider" Width="118" Minimum="0" Maximum="2"
                                TickFrequency="0.02" IsSnapToTickEnabled="True" SmallChange="0.02"
                                LargeChange="0.1" IsMoveToPointEnabled="True" Value="1" Margin="4,0,0,0"
                                ValueChanged="PlayerVolumeSlider_ValueChanged"
                                PreviewMouseLeftButtonUp="PlayerVolumeSlider_MouseLeftButtonUp"
                                KeyUp="PlayerVolumeSlider_KeyUp" />
                        <TextBlock x:Name="PlayerVolumeText" Width="40" Text="100%"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
