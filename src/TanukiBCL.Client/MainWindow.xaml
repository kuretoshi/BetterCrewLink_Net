<Window x:Class="TanukiBCL.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TanukiBCL.Client"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TanukiBCL" Width="280" Height="390" MinWidth="280" MinHeight="390"
        WindowStyle="None" Background="#25232A" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,8,10,0" />
        </Style>
    </Window.Resources>
    <Grid>
      <local:VoiceView x:Name="CompactVoiceView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Grid x:Name="DiagnosticsGrid" Visibility="Collapsed" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="音声画面へ" Width="105" Click="BackButton_Click" VerticalAlignment="Top" />
                <Button x:Name="DiagnosticsCloseButton" Content="×" Width="40" Click="DiagnosticsCloseButton_Click" VerticalAlignment="Top" />
            </StackPanel>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙ 設定"
                    Width="100" Click="SettingsButton_Click" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="TanukiBCL" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Among Us 近距離ボイスクライアント" Foreground="#AEB6C2" Margin="0,3,0,22" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="3">
                <TextBlock Text="Among Usプロセス" />
                <DockPanel>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="再検出" Width="88"
                            Margin="10,6,0,14" Click="RefreshButton_Click" />
                    <ComboBox x:Name="ProcessCombo" DisplayMemberPath="DisplayName" />
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="マイク" />
                <ComboBox x:Name="InputCombo" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="スピーカー" />
                <ComboBox x:Name="OutputCombo" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#20252D" CornerRadius="8" Padding="18" Margin="0,14,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Among Usを検出してください" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="GameText" Text="ゲーム状態: 未接続" Foreground="#B8C0CC" Margin="0,10,0,0" />
                    <TextBlock x:Name="LobbyText" Text="ロビー: —" Foreground="#B8C0CC" Margin="0,6,0,0" />
                    <TextBlock x:Name="PlayersText" Text="参加者: —" Foreground="#B8C0CC" Margin="0,6,0,0" />
                    <TextBlock x:Name="VadText" Text="マイク: 待機中" Foreground="#B8C0CC" Margin="0,6,0,0" />
                    <TextBlock x:Name="SentText" Text="Opus送信: 待機中" Foreground="#B8C0CC" Margin="0,6,0,0" />
                </StackPanel>
                <DataGrid x:Name="PeerGrid" Grid.Row="1" Margin="0,16,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="#20252D" Foreground="#F5F7FA" BorderThickness="0"
                          RowBackground="#20252D" AlternatingRowBackground="#252B34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="プレイヤー" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Peer" Binding="{Binding Connection}" Width="110" />
                        <DataGridTextColumn Header="音声" Binding="{Binding Voice}" Width="150" />
                        <DataGridTextColumn Header="ラジオ" Binding="{Binding Radio}" Width="80" />
                        <DataGridTextColumn Header="Opus受信" Binding="{Binding Received}" Width="100" />
                        <DataGridTextColumn Header="音量" Binding="{Binding Gain}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="StartButton" Content="接続開始" Width="130" Background="#42A66B"
                    Foreground="White" Click="StartButton_Click" />
            <Button x:Name="StopButton" Content="停止" Width="100" IsEnabled="False"
                    Click="StopButton_Click" />
            <Button x:Name="MuteButton" Content="マイクをミュート" Width="150" IsEnabled="False"
                    Click="MuteButton_Click" />
            <Button x:Name="DeafenButton" Content="スピーカーをミュート" Width="170" IsEnabled="False"
                    Click="DeafenButton_Click" />
          </StackPanel>
          <Button x:Name="RadioButton" Content="インポスターラジオ: OFF" Width="210" HorizontalAlignment="Left"
                  IsEnabled="False" Click="RadioButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
</Window>
