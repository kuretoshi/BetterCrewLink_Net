                                             Style="{StaticResource AudioModeRadioStyle}"
                                             MinHeight="32" Margin="0,0,0,6" />
                                <RadioButton x:Name="PushToMuteModeRadio" Content="押してミュート" GroupName="MicrophoneMode"
                                             Style="{StaticResource AudioModeRadioStyle}"
                                             MinHeight="32" />
                            </StackPanel>
                        </Border>
