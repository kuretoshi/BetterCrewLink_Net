<Window x:Class="TanukiBCL.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TanukiBCL.Client"
        Title="設定" Width="760" Height="620" MinWidth="650" MinHeight="500"
        Background="#1D1B22" Foreground="#F5F1F7" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F1F7" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F1F7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="OverlaySwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="36" Height="20"
                                    CornerRadius="10" Background="#68646B" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#AE70BB" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="TuneIcon">M3 17v2h6v-2zM3 5v2h10V5zm10 16v-2h8v-2h-8v-2h-2v6zM7 9v2H3v2h4v2h2V9zm14 4v-2H11v2zm-6-4h2V7h4V5h-4V3h-2z</Geometry>
        <Geometry x:Key="GroupsIcon">M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91M4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C.48 14.9 0 15.62 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29M20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m4 3.43c0-.81-.48-1.53-1.22-1.85-.85-.37-1.79-.58-2.78-.58-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24zM12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3</Geometry>
        <Geometry x:Key="PersonIcon">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4m0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4</Geometry>
        <Geometry x:Key="VolumeIcon">M3 9v6h4l5 5V4L7 9zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02M14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77</Geometry>
        <Geometry x:Key="KeyboardIcon">M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2m-9 3h2v2h-2zm0 3h2v2h-2zM8 8h2v2H8zm0 3h2v2H8zm-1 2H5v-2h2zm0-3H5V8h2zm9 7H8v-2h8zm0-4h-2v-2h2zm0-3h-2V8h2zm3 3h-2v-2h2zm0-3h-2V8h2z</Geometry>
        <Geometry x:Key="LayersIcon">m11.99 18.54-7.37-5.73L3 14.07l9 7 9-7-1.63-1.27zM12 16l7.36-5.73L21 9l-9-7-9 7 1.63 1.27z</Geometry>
        <Geometry x:Key="ScienceIcon">M19.8 18.4 14 10.67V6.5l1.35-1.69c.26-.33.03-.81-.39-.81H9.04c-.42 0-.65.48-.39.81L10 6.5v4.17L4.2 18.4c-.49.66-.02 1.6.8 1.6h14c.82 0 1.29-.94.8-1.6</Geometry>
        <Geometry x:Key="UpdateIcon">M17 1.01 7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99M17 19H7V5h10zm-1-6h-3V8h-2v5H8l4 4z</Geometry>
        <Geometry x:Key="VideoIcon">M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11z</Geometry>
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="8,2" Padding="12,8">
                            <DockPanel LastChildFill="True">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0" DockPanel.Dock="Left">
                                    <Path x:Name="NavIcon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Fill="#AAA5AD" Width="24" Height="24" Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#302A35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#423348" />
                                <Setter TargetName="NavIcon" Property="Fill" Value="#CE93D8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="SettingsNavigation" Background="#19171D" BorderBrush="#403146" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8">
                <ListBox x:Name="CategoryList" Background="Transparent" Foreground="White"
                         BorderThickness="0"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBoxItem Content="一般" Tag="{StaticResource TuneIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="ロビー設定" Tag="{StaticResource GroupsIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="プレイヤー" Tag="{StaticResource PersonIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="オーディオ" Tag="{StaticResource VolumeIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="キー割り当て" Tag="{StaticResource KeyboardIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="オーバーレイ" Tag="{StaticResource LayersIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="詳細設定" Tag="{StaticResource ScienceIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="アップデート" Tag="{StaticResource UpdateIcon}" Style="{StaticResource CategoryItemStyle}" />
                    <ListBoxItem Content="配信設定" Tag="{StaticResource VideoIcon}" Style="{StaticResource CategoryItemStyle}" />
                </ListBox>
            </StackPanel>
        </Border>
        <Grid x:Name="SettingsContent" Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="一般" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,8" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1"
                                CornerRadius="8" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel" Text="言語" FontWeight="SemiBold" />
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1" DisplayMemberPath="Name" />
                            </Grid>
                        </Border>
                        <TextBlock Text="トラブルシューティング" FontSize="12" Foreground="#B7AABD" Margin="4,28,0,8" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1"
                                CornerRadius="8" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="デフォルトに戻す" FontWeight="SemiBold" />
                                    <TextBlock Text="すべての設定がリセットされます。" TextWrapping="Wrap"
                                               Foreground="#B7AABD" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button x:Name="ResetDefaultsButton" Grid.Column="1" Content="デフォルトに戻す"
                                        Click="ResetDefaultsButton_Click" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Padding="12,6" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ResetDisabledReason" Text="ゲーム内ではホストとして利用できません！"
                                   TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="LobbyPanel" Visibility="Collapsed">
                        <TextBlock Text="ロビー設定" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="CurrentLobbyTab" Content="現在のロビー" GroupName="LobbyView"
                                         Checked="LobbyTab_Changed" Margin="0,0,24,0" />
                            <RadioButton x:Name="MyLobbyTab" Content="自分の設定" GroupName="LobbyView"
                                         Checked="LobbyTab_Changed" />
                        </StackPanel>
                        <TextBlock x:Name="LobbyNotice" TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,0,0,20" />
                        <TextBlock x:Name="NoLobbyText" Text="現在参加中のロビー設定はありません。"
                                   Visibility="Collapsed" Foreground="#B7AABD" />
                        <StackPanel x:Name="LobbyControlsPanel">
                        <CheckBox x:Name="RadioOnlyCheck" Content="インポスターラジオ専用モード"
                                  Checked="RadioOnlyCheck_Changed" Unchecked="RadioOnlyCheck_Changed" Margin="0,0,0,5" />
                        <TextBlock Text="有効時は通常の近距離会話を停止し、関連設定を3.2.7と同じ値に固定します。解除すると元の設定に戻ります。"
                                   TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,0,0,20" />
                        <TextBlock x:Name="DistanceTitleText" Text="音声が届く距離" />
                        <DockPanel Margin="0,5,0,18">
                            <TextBlock x:Name="DistanceValue" DockPanel.Dock="Right" Width="45" TextAlignment="Right" />
                            <Slider x:Name="DistanceSlider" Minimum="1" Maximum="10" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <CheckBox x:Name="WallsBlockAudioCheck" Content="壁越しで音声をブロック" Margin="0,0,0,14" />
                        <CheckBox x:Name="VisionHearingCheck" Content="視界内のプレイヤーの声だけが聞こえる"
                                  Checked="VisionHearingCheck_Changed" Unchecked="VisionHearingCheck_Changed"
                                  Margin="0,0,0,14" />
                        <CheckBox x:Name="HauntingCheck" Content="インポスターは幽霊の声を聞ける" Margin="0,0,0,14" />
                        <CheckBox x:Name="HearVentsCheck" Content="ベント内のインポスターの声を聞ける" Margin="0,0,0,14" />
                        <CheckBox x:Name="ImpostorVentCheck" Content="ベント内のインポスター同士で会話できる" Margin="0,0,0,14" />
                        <CheckBox x:Name="ImpostorRadioCheck" Content="インポスターラジオを有効化" Margin="0,0,0,14" />
                        <CheckBox x:Name="CommsSabotageCheck" Content="通信妨害中はクルーメイトの受信を遮断" Margin="0,0,0,14" />
                        <CheckBox x:Name="HearThroughCamerasCheck" Content="カメラ越しに声が聞こえる" Margin="0,0,0,14" />
                        <CheckBox x:Name="VoiceEffectEnabledCheck" Content="変装時のボイスエフェクトを有効にする" Margin="0,0,0,14" />
                        <CheckBox x:Name="DeadOnlyCheck" Content="幽霊同士のみ会話できる" Margin="0,0,0,14" />
                        <CheckBox x:Name="MeetingGhostOnlyCheck" Content="会議中のみ幽霊以外も会話できる" Margin="0,0,0,14" />
                        <StackPanel x:Name="SnrControlsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="【MOD】SNR設定" FontWeight="SemiBold" Foreground="#C779D7"
                                       Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrJumboVoiceCheck" Content="ジャンボ役職の時、大きくなるほど声を太くする"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrJackalHauntingCheck" Content="第三陣営のキルできる役職が幽霊の声も聞こえる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrJackalRadioCheck" Content="ジャッカルラジオ" Margin="0,0,0,14"
                                      Checked="JackalRadioCheck_Changed" Unchecked="JackalRadioCheck_Changed" />
                            <CheckBox x:Name="SnrJackalHearOutsideVentsCheck"
                                      Content="ジャッカル、波動砲ジャッカルはベント内にいても声が聞こえる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrJackalTalkInVentsCheck"
                                      Content="ジャッカル、波動砲ジャッカル同士でベント内で会話ができる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrSidekickHauntingCheck" Content="サイドキックが幽霊の声も聞こえる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrSidekickHearOutsideVentsCheck"
                                      Content="サイドキックはベント内にいても声が聞こえる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="SnrSidekickTalkInVentsCheck"
                                      Content="サイドキックもジャッカル陣営同士でベント内で会話ができる"
                                      Margin="0,0,0,14" />
                        </StackPanel>
                        <StackPanel x:Name="TohControlsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="【MOD】TOH4E／TOH4E_EM設定" FontWeight="SemiBold"
                                       Foreground="#C779D7" Margin="0,0,0,14" />
                            <CheckBox x:Name="TohNeutralKillerHauntingCheck"
                                      Content="第三陣営・アニマル陣営のキルできる役職が幽霊の声も聞こえる"
                                      Margin="0,0,0,14" />
                        </StackPanel>
                        <StackPanel x:Name="NosControlsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="【MOD】NoS設定" FontWeight="SemiBold" Foreground="#C779D7"
                                       Margin="0,0,0,14" />
                            <CheckBox x:Name="JackalRadioCheck" Content="ジャッカルラジオ" Margin="0,0,0,14"
                                      Checked="JackalRadioCheck_Changed" Unchecked="JackalRadioCheck_Changed" />
                            <CheckBox x:Name="NosNeutralKillerHauntingCheck"
                                      Content="第三陣営のキルできる役職が幽霊の声も聞こえる"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="NosVoicePositionsCheck" Margin="0,0,0,14">
                                <TextBlock Text="話す位置と聞く位置をNoSの座標に変更" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox x:Name="NosSizeVoiceEffectCheck" Content="大きさが変化した場合にエフェクトをかける"
                                      Margin="0,0,0,14" />
                            <CheckBox x:Name="NosFixerJammingVoiceBlockCheck" Content="フィクサーの妨害を受けた際に音声を遮断する"
                                      Margin="0,0,0,14" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PlayersPanel" Visibility="Collapsed">
                        <TextBlock Text="プレイヤー" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBlock Text="プレイヤーごとの音量とミュートを調整します。変更はすぐに反映されます。"
                                   TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,0,0,18" />
                        <StackPanel x:Name="PlayerRows" />
                    </StackPanel>
                    <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                        <TextBlock Text="オーディオ" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
                        <TextBlock Text="マイク" Margin="0,0,0,6" />
                        <ComboBox x:Name="MicrophoneCombo" Margin="0,0,0,8"
                                  SelectionChanged="MicrophoneCombo_SelectionChanged" />
                        <ProgressBar x:Name="MicrophoneLevelBar" Minimum="0" Maximum="100" Height="8"
                                     Foreground="#B061C0" Background="#403146" Margin="0,0,0,5" />
                        <TextBlock x:Name="MicrophoneLevelStatus" Foreground="#B7AABD"
                                   Text="マイク入力レベル" Margin="0,0,0,16" />
                        <TextBlock Text="スピーカー" Margin="0,0,0,6" />
                        <ComboBox x:Name="SpeakerCombo" Margin="0,0,0,8"
                                  SelectionChanged="SpeakerCombo_SelectionChanged" />
                        <Button x:Name="TestSpeakerButton" Content="スピーカーテスト"
                                Width="170" Height="34" HorizontalAlignment="Right"
                                Margin="0,0,0,10" Click="TestSpeakerButton_Click" />
                        <TextBlock Text="デバイスの変更はすぐに反映されます。音声接続を切り替える間、一時的に通話が途切れます。"
                                   TextWrapping="Wrap"
                                   Foreground="#B7AABD" Margin="0,0,0,20" />
                        <TextBlock Text="音声操作モード" Margin="0,0,0,8" />
                        <RadioButton x:Name="VoiceModeRadio" Content="声で起動" GroupName="MicrophoneMode" Margin="0,0,0,7" />
                        <RadioButton x:Name="PushToTalkModeRadio" Content="押している間だけ話す" GroupName="MicrophoneMode" Margin="0,0,0,7" />
                        <RadioButton x:Name="PushToMuteModeRadio" Content="押している間だけミュート" GroupName="MicrophoneMode" Margin="0,0,0,20" />
                        <CheckBox x:Name="MicrophoneGainCheck" Content="マイク入力ゲインを調整する" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,18">
                            <TextBlock x:Name="MicrophoneGainValue" DockPanel.Dock="Right" Width="52" TextAlignment="Right" />
                            <Slider x:Name="MicrophoneGainSlider" Minimum="0" Maximum="300"
                                    TickFrequency="2" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsChecked, ElementName=MicrophoneGainCheck}"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <CheckBox x:Name="MicSensitivityCheck" Content="マイク感度で無音時の送信を抑える" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="MicSensitivityValue" DockPanel.Dock="Right" Width="52" TextAlignment="Right" />
                            <Slider x:Name="MicSensitivitySlider" Minimum="0" Maximum="1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsChecked, ElementName=MicSensitivityCheck}"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <TextBlock Text="値を上げるほど小さな声にも反応します。無音時は送信音声を抑えます。"
                                   TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,0,0,18" />
                        <TextBlock Text="マスター音量" />
                        <DockPanel Margin="0,5,0,20">
                            <TextBlock x:Name="MasterVolumeValue" DockPanel.Dock="Right" Width="52" TextAlignment="Right" />
                            <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="200"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <TextBlock Text="幽霊として聞く生存者の音量" />
                        <DockPanel Margin="0,5,0,20">
                            <TextBlock x:Name="CrewVolumeAsGhostValue" DockPanel.Dock="Right" Width="52" TextAlignment="Right" />
                            <Slider x:Name="CrewVolumeAsGhostSlider" Minimum="0" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <TextBlock Text="インポスターとして聞く幽霊の音量" />
                        <DockPanel Margin="0,5,0,20">
                            <TextBlock x:Name="GhostVolumeAsImpostorValue" DockPanel.Dock="Right" Width="52" TextAlignment="Right" />
                            <Slider x:Name="GhostVolumeAsImpostorSlider" Minimum="0" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <TextBlock Text="変装時のボイスエフェクトの強さ" />
                        <DockPanel Margin="0,5,0,12">
                            <TextBlock x:Name="VoiceEffectStrengthValue" DockPanel.Dock="Right" Width="52" TextAlignment="Right" />
                            <Slider x:Name="VoiceEffectStrengthSlider" Minimum="0" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </DockPanel>
                        <Button x:Name="TestVoiceEffectButton" Content="ボイスエフェクトテスト"
                                Width="240" Height="40" HorizontalAlignment="Center" Margin="0,0,0,20"
                                Click="TestVoiceEffectButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="KeybindsPanel" Visibility="Collapsed">
                        <TextBlock Text="キー割り当て" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <TextBlock Text="欄をクリックしてキーを押してください。Escで無効化できます。"
                                   TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,0,0,18" />
                        <TextBlock Text="押して話す／押してミュート" />
                        <TextBox x:Name="PushToTalkShortcutBox" IsReadOnly="True" Margin="0,6,0,16"
                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown" PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                        <TextBlock Text="インポスターラジオ" />
                        <TextBox x:Name="ImpostorRadioShortcutBox" IsReadOnly="True" Margin="0,6,0,16"
                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown" PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                        <TextBlock Text="マイクミュート切替" />
                        <TextBox x:Name="MuteShortcutBox" IsReadOnly="True" Margin="0,6,0,16"
                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown" PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                        <TextBlock Text="スピーカーミュート切替" />
                        <TextBox x:Name="DeafenShortcutBox" IsReadOnly="True" Margin="0,6,0,16"
                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown" PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                    </StackPanel>
                    <StackPanel x:Name="OverlayPanel" Visibility="Collapsed">
                        <TextBlock Text="オーバーレイ" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,8" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="OverlayAlwaysOnTopCheck" Content="常に手前に表示"
                                              Style="{StaticResource OverlaySwitchStyle}" />
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="EnableOverlayCheck" Content="ゲーム画面にオーバーレイを表示"
                                              Style="{StaticResource OverlaySwitchStyle}" />
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="CompactOverlayCheck" Content="発話中のプレイヤーだけを表示"
                                              Style="{StaticResource OverlaySwitchStyle}"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableOverlayCheck}" />
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="MeetingOverlayCheck" Content="会議中の発話枠を表示"
                                              Style="{StaticResource OverlaySwitchStyle}"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableOverlayCheck}" />
                                </Border>
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="アバターの位置" VerticalAlignment="Center" />
                                    <ComboBox x:Name="OverlayPositionCombo" Grid.Column="1"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableOverlayCheck}">
                                        <ComboBoxItem Content="表示しない" Tag="hidden" />
                                        <ComboBoxItem Content="上" Tag="top" />
                                        <ComboBoxItem Content="左下" Tag="bottom_left" />
                                        <ComboBoxItem Content="右" Tag="right" />
                                        <ComboBoxItem Content="右（発話中に名前表示）" Tag="right1" />
                                        <ComboBoxItem Content="左" Tag="left" />
                                        <ComboBoxItem Content="左（発話中に名前表示）" Tag="left1" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <TextBlock Text="詳細設定" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" />
                        <TextBlock Text="ボイスサーバー" Margin="0,0,0,6" />
                        <ComboBox x:Name="ServerUrlBox" IsEditable="False" Margin="0,0,0,18"
                                  SelectionChanged="ServerUrlBox_SelectionChanged" />
                        <CheckBox x:Name="NatFixCheck" Content="NATの修正" Margin="0,0,0,6" />
                        <TextBlock Text="P2Pの代わりにTURNサーバーを経由します。接続の問題を解決できますが、遅延が増える場合があります。"
                                   TextWrapping="Wrap" Foreground="#A8A4B0" Margin="0,0,0,20" />
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="ボイスサーバー" FontWeight="SemiBold" />
                                <TextBlock x:Name="ServerUrlDescription" Foreground="#B7AABD" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="ChangeServerButton" Grid.Column="1" Content="ボイスサーバーの変更"
                                    Background="#F44336" Foreground="White" Padding="10,6"
                                    VerticalAlignment="Center" Click="ChangeServerButton_Click" />
                        </Grid>
                        <TextBlock Text="音声処理" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <CheckBox x:Name="MobileHostCheck" Content="モバイル ホスト" Margin="0,0,0,8" />
                        <CheckBox x:Name="HardwareAccelerationCheck" Content="ハードウェア アクセラレーション" Margin="0,0,0,8" />
                        <TextBlock Text="ハードウェアアクセラレーションを無効にします（CPU使用率が上がる可能性があります）"
                                   TextWrapping="Wrap" Foreground="#B7AABD" Margin="0,0,0,12" />
                        <CheckBox x:Name="EchoCancellationCheck" Content="エコーキャンセラー" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoGainControlCheck" Content="自動ゲイン調整" Margin="0,0,0,8"
                                  Checked="AutoGainControlCheck_Changed" Unchecked="AutoGainControlCheck_Changed" />
                        <TextBlock Text="ベータ版：マイク音量を自動調整します。先にテストしてください。"
                                   TextWrapping="Wrap" Foreground="#A8A4B0" Margin="0,0,0,8" />
                        <CheckBox x:Name="SpatialAudioCheck" Content="立体音響" Margin="0,0,0,8" />
                        <TextBlock Text="OFFでも声が届く距離や壁の遮断は有効です。距離内の音量と左右配置を固定します。"
                                   TextWrapping="Wrap" Foreground="#A8A4B0" Margin="0,0,0,8" />
                        <CheckBox x:Name="NoiseSuppressionCheck" Content="ノイズ防止" Margin="0,0,0,8" />
                        <CheckBox x:Name="OldSampleDebugCheck" Content="サンプルレートデバッグ" Margin="0,0,0,8" />
                        <TextBlock Text="依頼された場合のみ有効にするテスト機能です。ONではマイク入力を48 kHzで要求します。"
                                   TextWrapping="Wrap" Foreground="#A8A4B0" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel x:Name="UpdatePanel" Visibility="Collapsed">
                        <TextBlock Text="アップデート" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" />
                        <Border Background="#29252F" Padding="20" CornerRadius="6">
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" Margin="0,0,0,12" />
                                <TextBlock x:Name="UpdateStatusText" Text="アップデートを確認してください。"
                                           FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="100"
                                             Visibility="Collapsed" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button x:Name="CheckUpdateButton" Content="アップデートを確認"
                                            Padding="14,8" MinWidth="175" Margin="0,0,12,8"
                                            Click="CheckUpdateButton_Click" />
                                    <Button x:Name="StartUpdateButton" Content="アップデート開始"
                                            Padding="14,8" MinWidth="175" Margin="0,0,0,8" IsEnabled="False"
                                            Background="#8B4D99" Foreground="White" Click="StartUpdateButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="開始後はダウンロードを検証し、アプリを終了して更新します。旧版はバックアップとして残します。"
                                           FontSize="12" Foreground="#B7AABD" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="StreamingPanel" Visibility="Collapsed">
                        <TextBlock Text="配信設定" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" />
                        <CheckBox x:Name="ShowLobbyCodeCheck" Content="ロビーコードの表示" Margin="0,0,0,18" />
                        <CheckBox x:Name="ObsOverlayCheck" Content="OBS ブラウザーのオーバーレイ"
                                  Checked="ObsOverlayCheck_Changed" Unchecked="ObsOverlayCheck_Changed"
                                  Margin="0,0,0,18" />
                        <StackPanel x:Name="ObsUrlPanel" Visibility="Collapsed">
                            <TextBlock Text="OBSブラウザソースURL" Margin="0,0,0,7" />
                            <TextBox x:Name="ObsUrlBox" IsReadOnly="True" Margin="0,0,0,10" />
                            <Button Content="URLをコピー" Width="130" Height="34" HorizontalAlignment="Left"
                                    Click="CopyObsUrlButton_Click" />
                            <TextBlock Text="URLに配信接続用の識別子が含まれます。共有先に注意してください。"
                                       Foreground="#B7AABD" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="0,16,0,0">
                <Button x:Name="CloseSettingsButton" Content="閉じる" Width="100" Height="36" DockPanel.Dock="Right"
                        Background="#8B4D99" Foreground="White" Click="CloseSettingsButton_Click" />
                <TextBlock x:Name="SaveStatusText" Text="変更は自動的に反映・保存されます。"
                           Foreground="#B7AABD" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Grid>
        <Grid x:Name="ServerDialogBackdrop" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed"
              MouseDown="ServerDialogBackdrop_MouseDown">
            <local:ServerUrlDialog x:Name="ServerDialog" Margin="32" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="ConfirmDialogBackdrop" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed"
              MouseDown="ConfirmDialogBackdrop_MouseDown">
            <local:SettingsConfirmDialog x:Name="ConfirmDialog" Margin="32" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
