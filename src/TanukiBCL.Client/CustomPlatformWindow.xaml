<Window x:Class="TanukiBCL.Client.CustomPlatformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カスタム起動先" Width="480" Height="440" MinWidth="400" MinHeight="380"
        Background="#1D1B22" Foreground="#F5F1F7" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="カスタム起動先" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名前" Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" Height="32" Padding="8,4" Margin="0,0,0,16" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="ExeTypeRadio" Content="EXE" GroupName="LaunchType"
                                 IsChecked="True" Checked="LaunchType_Changed" Margin="0,0,22,0" />
                    <RadioButton x:Name="UriTypeRadio" Content="URI" GroupName="LaunchType"
                                 Checked="LaunchType_Changed" />
                </StackPanel>
                <TextBlock x:Name="RunPathLabel" Text="実行ファイル" Margin="0,0,0,5" />
                <DockPanel Margin="0,0,0,14">
                    <Button x:Name="BrowseButton" Content="ファイルを選択" DockPanel.Dock="Right"
                            Padding="10,5" Margin="8,0,0,0" Click="BrowseButton_Click" />
                    <TextBox x:Name="RunPathBox" Height="32" Padding="8,4" IsReadOnly="True" />
                </DockPanel>
                <CheckBox x:Name="AdvancedCheck" Content="詳細設定" Margin="0,0,0,10"
                          Checked="AdvancedCheck_Changed" Unchecked="AdvancedCheck_Changed" />
                <StackPanel x:Name="ArgumentsPanel" Visibility="Collapsed">
                    <TextBlock Text="起動引数（スペース区切り）" Margin="0,0,0,5" />
                    <TextBox x:Name="ArgumentsBox" Height="32" Padding="8,4" Margin="0,0,0,10" />
                </StackPanel>
                <TextBlock x:Name="ValidationText" Foreground="#FF8585" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="DeleteButton" Content="削除" DockPanel.Dock="Left" Padding="12,7"
                    Click="DeleteButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Padding="12,7" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button Content="保存" Padding="16,7" Background="#8B4D99" Foreground="White"
                        Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
