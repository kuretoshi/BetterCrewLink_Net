                                <Border Height="1" Background="#403A45" />
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
