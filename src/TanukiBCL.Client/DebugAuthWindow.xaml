<Window x:Class="TanukiBCL.Client.DebugAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="開発者認証" Width="420" Height="220" MinWidth="380" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#25232A" Foreground="#F5F1F7">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="開発者認証" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Grid.Row="1" Text="開発者用パスワードを入力してください。"
                   Foreground="#B7AABD" Margin="0,0,0,10" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="34" Padding="8,5"
                     PasswordChanged="PasswordInput_PasswordChanged" KeyDown="PasswordInput_KeyDown" />
        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#FF8A80" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,8,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="95" Height="32" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="OpenButton" Content="開く" Width="95" Height="32" IsEnabled="False"
                    Background="#AE70BB" Foreground="White" Click="OpenButton_Click" />
        </StackPanel>
    </Grid>
</Window>
