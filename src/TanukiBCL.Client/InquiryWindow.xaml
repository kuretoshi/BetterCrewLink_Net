<Window x:Class="TanukiBCL.Client.InquiryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TanukiBCL Inquiry" Width="620" Height="640" MinWidth="460" MinHeight="480"
        Background="#25232A" Foreground="#F5F1F7" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="InquiryFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="BorderBrush" Value="#817A84" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CaretBrush" Value="#CE93D8" />
            <Setter Property="SelectionBrush" Value="#BA68C8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#CE93D8" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InquiryComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#25232A" />
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="BorderBrush" Value="#817A84" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#25232A" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="12,8" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#49374E" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="14,0,2,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path Grid.Column="1" Data="M7 10l5 5 5-5z" Fill="#F5F1F7"
                                          Width="20" Height="20" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#25232A" BorderBrush="#817A84" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryActionStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="BorderBrush" Value="#F44336" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#49464C" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#49464C" />
                                <Setter Property="Foreground" Value="#918C95" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquirySendStyle" TargetType="Button" BasedOn="{StaticResource InquiryActionStyle}">
            <Setter Property="Background" Value="#F44336" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="InquiryTextActionStyle" TargetType="Button" BasedOn="{StaticResource InquiryActionStyle}">
            <Setter Property="Foreground" Value="#CE93D8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Background="#25232A">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Background="#1D1A23" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="10,0,68,0" VerticalAlignment="Center">
                <Border Width="14" Height="14" CornerRadius="7" BorderBrush="#CE93D8"
                        BorderThickness="1" Margin="0,0,6,0">
                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="#CE93D8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="問い合わせ" Foreground="#CE93D8" FontSize="13" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeInquiryButton" Width="34" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#777" FontSize="16" Content="−"
                        Click="MinimizeInquiryButton_Click" ToolTip="最小化" />
                <Button x:Name="CloseInquiryButton" Width="34" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#777" FontSize="16" Content="×"
                        Click="CloseInquiryButton_Click" ToolTip="閉じる" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">
                <Border x:Name="ResultBanner" Visibility="Collapsed" CornerRadius="4" Padding="12"
                        BorderThickness="1" Margin="0,0,0,16">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="14" />
                </Border>
                <ComboBox x:Name="TagCombo" Height="56" SelectedIndex="0" Margin="0,0,0,16"
                          Style="{StaticResource InquiryComboStyle}">
                    <ComboBoxItem Content="質問" Tag="question" />
                    <ComboBoxItem Content="不具合" Tag="bug" />
                    <ComboBoxItem Content="要望" Tag="request" />
                </ComboBox>
                <Grid Margin="0,0,0,16" Height="56">
                    <TextBox x:Name="SubjectBox" Height="56" MaxLength="100" Padding="12,12"
                             Style="{StaticResource InquiryFieldStyle}"
                             TextChanged="Input_Changed" GotKeyboardFocus="Field_FocusChanged"
                             LostKeyboardFocus="Field_FocusChanged" />
                    <TextBlock x:Name="SubjectLabel" Text="件名" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Foreground="#B7AABD" />
                </Grid>
                <Grid Margin="0,0,0,16" Height="170">
                    <TextBox x:Name="BodyBox" MinHeight="170" MaxLength="1800" Padding="12,10"
                             Style="{StaticResource InquiryFieldStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="Input_Changed" GotKeyboardFocus="Field_FocusChanged"
                             LostKeyboardFocus="Field_FocusChanged" />
                    <TextBlock x:Name="BodyLabel" Text="本文" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Foreground="#B7AABD" />
                </Grid>
                <Button x:Name="SelectFilesButton" HorizontalAlignment="Left"
                        Style="{StaticResource InquiryActionStyle}" Click="SelectFilesButton_Click" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5S13.5 3.62 13.5 5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="添付ファイルを選択" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="AttachmentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinHeight="32">
                                <Button DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveFileButton_Click"
                                        Width="32" Height="32" Padding="5" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="#B7AABD" BorderThickness="0" ToolTip="削除">
                                    <Path Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z"
                                          Fill="#B7AABD" Stretch="Uniform" />
                                </Button>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="送信時、サポートログがある場合は自動添付されます。"
                           Foreground="#B7AABD" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#3D3942" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="キャンセル" Style="{StaticResource InquiryTextActionStyle}"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button x:Name="SendButton" IsEnabled="False"
                        Style="{StaticResource InquirySendStyle}" Click="SendButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="送信" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
