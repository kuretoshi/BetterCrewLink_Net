<Window x:Class="TanukiBCL.Client.DebugInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TanukiBCL Debug" Width="900" Height="680" MinWidth="620" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#25232A" Foreground="#F5F1F7">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DebugTextStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MaxHeight" Value="420" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#1D1A23" />
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="#44404A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#1D1A23" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="12,0,70,0" VerticalAlignment="Center">
                <Path Width="16" Height="16" Stretch="Uniform" Fill="#CE93D8" Margin="0,0,8,0"
                      Data="M20 8h-2.81a5.98 5.98 0 0 0-1.64-1.64L17 4.41 15.59 3l-1.92 1.92A5.79 5.79 0 0 0 12 4c-.6 0-1.16.09-1.69.24L8.41 2.29 7 3.71l1.55 1.55A5.98 5.98 0 0 0 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81A6 6 0 0 0 18 15v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-8 9a2 2 0 0 1-2-2h4a2 2 0 0 1-2 2zm4-5H8v-1c0-.35.06-.69.17-1H16v2zm0-4H8.17A4 4 0 0 1 12 6c1.64 0 3.07.81 3.83 2z" />
                <TextBlock x:Name="DebugTitleText" FontSize="13" Foreground="#CE93D8"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeDebugButton" Width="34" Height="30" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#B7AABD" FontSize="16" Content="−"
                        Click="MinimizeDebugButton_Click" ToolTip="最小化" />
                <Button x:Name="CloseDebugButton" Width="34" Height="30" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#B7AABD" FontSize="16" Content="×"
                        Click="CloseDebugButton_Click" ToolTip="閉じる" />
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="16,8,16,4">
            <Button x:Name="SaveLogButton" DockPanel.Dock="Right" Content="ログを保存" VerticalAlignment="Top"
                    Padding="12,6" Click="SaveLogButton_Click" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ModNameText" FontSize="13" />
                <TextBlock x:Name="LiveSummaryText" Foreground="#B7AABD" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="DebugScroll" Grid.Row="2" Margin="16,4,4,12" Padding="0,0,12,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="ModStatusPanel" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                        Background="#1D3047" Visibility="Collapsed">
                    <TextBlock x:Name="ModStatusText" TextWrapping="Wrap" FontSize="12" />
                </Border>
                <Border x:Name="NosNoticePanel" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                        Background="#1D3047" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="NoSの陣営・サイズはTBCLFields、役職と能力は別の読み取り経路で取得します。未取得時は下の状態表示を確認してください。" />
                </Border>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Padding="8,6" Background="#1D1A23" Foreground="#F5F1F7"
                             BorderBrush="#5C565F" CaretBrush="#F5F1F7" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Text="プレイヤー名・ID・役職名で検索" Margin="11,0,0,0"
                               VerticalAlignment="Center" Foreground="#8D8392" IsHitTestVisible="False" />
                </Grid>
                <WrapPanel Margin="0,4,0,8">
                    <TextBlock x:Name="PlayerCountText" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#66BB6A" Padding="8,1" Margin="0,0,6,0">
                        <TextBlock Text="true / はい" FontSize="11" Foreground="#66BB6A" />
                    </Border>
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#8D8392" Padding="8,1" Margin="0,0,6,0">
                        <TextBlock Text="false / いいえ" FontSize="11" Foreground="#C9C0CC" />
                    </Border>
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#FFA726" Padding="8,1">
                        <TextBlock Text="未取得" FontSize="11" Foreground="#FFA726" />
                    </Border>
                </WrapPanel>
                <StackPanel x:Name="PlayerCards" />
                <TextBlock x:Name="EmptyPlayersText" Margin="0,8" Visibility="Collapsed" />
                <TextBlock x:Name="SnrHintText" Margin="0,4,0,8" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="SNRの詳細な割り当て陣営・勝利陣営は下の「SNR：役職・割り当て陣営・勝利陣営」で自動更新されます。" />
                <Expander x:Name="NosExpander" Header="NoS：コスチューム・無線・一覧ファイル" Visibility="Collapsed"
                          Expanded="Section_Expanded">
                    <TextBox x:Name="NosContentsText" Style="{StaticResource DebugTextStyle}" />
                </Expander>
                <Expander x:Name="SnrExpander" Header="SNR：役職・割り当て陣営・勝利陣営" Visibility="Collapsed"
                          Expanded="Section_Expanded">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock x:Name="SnrStatusText" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="#B7AABD" />
                        <DataGrid x:Name="SnrPlayersGrid" AutoGenerateColumns="False" MaxHeight="320"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="#1D1A23" Foreground="#F5F1F7" BorderBrush="#44404A"
                                  RowBackground="#1D1A23" AlternatingRowBackground="#25232A"
                                  HorizontalGridLinesBrush="#44404A" VerticalGridLinesBrush="#44404A">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#25232A" />
                                    <Setter Property="Foreground" Value="#F5F1F7" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="#F5F1F7" />
                                    <Setter Property="Padding" Value="8,5" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Player ID" Binding="{Binding PlayerId}" Width="75" />
                                <DataGridTextColumn Header="SNR役職" Binding="{Binding Role}" Width="*" />
                                <DataGridTextColumn Header="割り当て陣営" Binding="{Binding AssignedTeam}" Width="*" />
                                <DataGridTextColumn Header="勝利陣営" Binding="{Binding WinnerTeam}" Width="*" />
                                <DataGridTextColumn Header="チーム" Binding="{Binding TeamTag}" Width="*" />
                                <DataGridTextColumn Header="追加属性" Binding="{Binding Modifier}" Width="*" />
                                <DataGridTextColumn Header="幽霊役職" Binding="{Binding GhostRole}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander x:Name="GameExpander" Header="ゲーム状態" Expanded="Section_Expanded">
                    <TextBox x:Name="GameStateText" Style="{StaticResource DebugTextStyle}" />
                </Expander>
                <Expander x:Name="VoiceExpander" Header="音声接続" Expanded="Section_Expanded">
                    <TextBox x:Name="VoiceText" Style="{StaticResource DebugTextStyle}" />
                </Expander>
                <Expander x:Name="LogExpander" Header="ログ（最新64KB）" Expanded="Section_Expanded">
                    <TextBox x:Name="LogText" Style="{StaticResource DebugTextStyle}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
