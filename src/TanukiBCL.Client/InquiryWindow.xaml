<Window x:Class="TanukiBCL.Client.InquiryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TanukiBCL Inquiry" Width="620" Height="640" MinWidth="460" MinHeight="480"
        Background="#25232A" Foreground="#F5F1F7" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Background="#1D1A23" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="10,0,68,0" VerticalAlignment="Center">
                <Border Width="14" Height="14" CornerRadius="7" BorderBrush="#CE93D8"
                        BorderThickness="1" Margin="0,0,6,0">
                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="#CE93D8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="問い合わせ" Foreground="#CE93D8" FontSize="13" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeInquiryButton" Width="34" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#777" FontSize="16" Content="−"
                        Click="MinimizeInquiryButton_Click" ToolTip="最小化" />
                <Button x:Name="CloseInquiryButton" Width="34" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#777" FontSize="16" Content="×"
                        Click="CloseInquiryButton_Click" ToolTip="閉じる" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
                <ComboBox x:Name="TagCombo" Height="36" SelectedIndex="0" Margin="0,0,0,15">
                    <ComboBoxItem Content="質問" Tag="question" />
                    <ComboBoxItem Content="不具合" Tag="bug" />
                    <ComboBoxItem Content="要望" Tag="request" />
                </ComboBox>
                <TextBlock Text="件名" Margin="0,0,0,5" />
                <TextBox x:Name="SubjectBox" Height="36" MaxLength="100" Padding="9,6" Margin="0,0,0,15"
                         TextChanged="Input_Changed" />
                <TextBlock Text="本文" Margin="0,0,0,5" />
                <TextBox x:Name="BodyBox" MinHeight="170" MaxLength="1800" Padding="9,7" Margin="0,0,0,15"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="Input_Changed" />
                <Button x:Name="SelectFilesButton" Content="添付ファイルを選択" HorizontalAlignment="Left"
                        Padding="14,8" Click="SelectFilesButton_Click" Margin="0,0,0,10" />
                <ItemsControl x:Name="AttachmentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinHeight="32">
                                <Button DockPanel.Dock="Right" Content="削除" Tag="{Binding}" Click="RemoveFileButton_Click"
                                        Padding="8,2" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="送信時、サポートログがある場合は自動添付されます。"
                           Foreground="#B7AABD" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#3D3942" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="キャンセル" Padding="16,9" Margin="0,0,10,0"
                        Click="CancelButton_Click" />
                <Button x:Name="SendButton" Content="送信" Padding="20,9" IsEnabled="False"
                        Background="#8B4D99" Foreground="White" Click="SendButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
