                                <CheckBox x:Name="ImpostorVentCheck" Content="インポスター同士でベント内で会話ができる"
                                          Style="{StaticResource LobbySwitchStyle}" />
                                <CheckBox x:Name="CommsSabotageCheck" Content="コミュサボタージュで音声を無効化"
                                          Style="{StaticResource LobbySwitchStyle}" />
                                <CheckBox x:Name="HearThroughCamerasCheck" Content="カメラ越しに声が聞こえる"
                                          Style="{StaticResource LobbySwitchStyle}" />
                                <CheckBox x:Name="ImpostorRadioCheck" Content="インポスターラジオ"
                                          Style="{StaticResource LobbySwitchStyle}" />
                                <CheckBox x:Name="DeadOnlyCheck" Content="幽霊だけが話す/聞くことが可能"
                                          Style="{StaticResource LobbySwitchStyle}" />
                                <TextBlock x:Name="DeadOnlyDescription" Text="生きているプレーヤーのサウンドを無効にする。"
                                           TextWrapping="Wrap" Foreground="#B7AABD" FontSize="12"
                                           Margin="16,-7,62,14" />
