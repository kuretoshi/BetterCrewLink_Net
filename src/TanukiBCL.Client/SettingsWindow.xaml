                                <Grid Margin="16,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="マイク" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="MicrophoneCombo" Style="{StaticResource DarkAudioComboStyle}"
                                                  SelectionChanged="MicrophoneCombo_SelectionChanged" />
                                        <ProgressBar x:Name="MicrophoneLevelBar" Minimum="0" Maximum="100"
                                                     Style="{StaticResource AudioLevelBarStyle}" Margin="0,12,0,0" />
                                        <TextBlock x:Name="MicrophoneLevelStatus" Foreground="IndianRed"
                                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#403A45" />
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="スピーカー" FontWeight="SemiBold" />
