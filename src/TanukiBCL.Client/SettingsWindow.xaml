                                          Style="{StaticResource LobbySwitchStyle}" />
                                <TextBlock x:Name="MeetingGhostOnlyDescription" Text="会議以外での生存プレイヤーのサウンドを無効にします"
                                           TextWrapping="Wrap" Foreground="#B7AABD" FontSize="12"
                                           Margin="16,-7,62,14" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="SnrControlsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="【MOD】SNR設定" FontWeight="SemiBold" Foreground="#C779D7"
                                       Margin="0,0,0,14" />
