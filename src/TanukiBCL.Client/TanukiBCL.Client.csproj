<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TanukiBCL.Net</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.2.7-netdev.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TanukiBCL.VoiceProbe\TanukiBCL.VoiceProbe.csproj" />
    <Resource Include="Assets\Avatar\*.png" />
    <Content Include="Assets\Audio\chime.mp3" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\update-manifest.json" Link="update-manifest.json"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\SpeexDSPSharp.*.LICENSE.txt"
             Link="Licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BundleNosSnapshotReader" BeforeTargets="ComputeFilesToPublish">
    <MSBuild Projects="..\..\tools\TbclSnapshotReader\TbclSnapshotReader.csproj"
             Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x86;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=None;PublishDir=$(MSBuildProjectDirectory)\obj\nos-reader-publish\" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\obj\nos-reader-publish\TbclSnapshotReader.exe">
        <RelativePath>NoSReader\TbclSnapshotReader.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="BundleSnrRoleReader" BeforeTargets="ComputeFilesToPublish">
    <MSBuild Projects="..\..\tools\SnrRoleReader\SnrRoleReader.csproj"
             Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x86;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=None;PublishDir=$(MSBuildProjectDirectory)\obj\snr-reader-publish\" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\obj\snr-reader-publish\SnrRoleReader.exe">
        <RelativePath>RoleReaders\SnrRoleReader.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="BundleUpdater" BeforeTargets="ComputeFilesToPublish">
    <MSBuild Projects="..\..\tools\TanukiBCL.Updater\TanukiBCL.Updater.csproj"
             Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x64;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=None;PublishDir=$(MSBuildProjectDirectory)\obj\updater-publish\" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\obj\updater-publish\TanukiBCL.Updater.exe">
        <RelativePath>Updater\TanukiBCL.Updater.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
