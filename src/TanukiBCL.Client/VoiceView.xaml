<UserControl x:Class="TanukiBCL.Client.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TanukiBCL.Client"
             Background="#25232A" Foreground="White">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#25232A" PreviewMouseDown="VoiceView_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FooterRow" Height="52" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1D1A23" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="42,0,25,0">
                <TextBlock Text="タヌキのベタクル" Foreground="#CE93D8" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="#CE93D8" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SettingsButton" Width="24" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Click="SettingsButton_Click" ToolTip="設定" AutomationProperties.Name="設定">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#777" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6" />
                    </Canvas>
                </Button>
                <Button x:Name="ReloadButton" Width="24" Height="24" Padding="0" BorderThickness="0"
                        Background="Transparent" Click="ReloadButton_Click" ToolTip="再読み込み" AutomationProperties.Name="再読み込み">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#777" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z" />
                    </Canvas>
                </Button>
            </StackPanel>
            <Button x:Name="CloseButton" Width="24" Height="24" Padding="0" BorderThickness="0"
                    HorizontalAlignment="Right" Background="Transparent"
                    Click="CloseButton_Click" ToolTip="閉じる" AutomationProperties.Name="閉じる">
                <Canvas Width="24" Height="24">
                    <Path Fill="#777" Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Canvas>
            </Button>
        </Grid>

        <StackPanel x:Name="HeaderPanel" Grid.Row="1" Margin="0,-6,0,6">
            <Grid x:Name="LobbyHeader" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="LocalAvatarSlot" Grid.Column="0" Width="100" Height="100">
                    <local:PlayerAvatar x:Name="LocalAvatar" Width="90" Height="90"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <!-- 3.2.7 uses nowrap in a 115px box with visible overflow,
                             not ellipsis or font shrinking. Measure unconstrained. -->
                        <Canvas Width="115" Height="24" ClipToBounds="False">
                            <TextBlock x:Name="LocalName" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="None" />
                        </Canvas>
                        <Border x:Name="CodeBackground" Background="#3E4346" CornerRadius="5"
                                Padding="9,5" Margin="0,5,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="LobbyCode" FontSize="28" FontFamily="Consolas"
                                       Text="MENU" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,26,0,0">
                        <Button x:Name="MuteButton" Width="26" Height="26" Padding="0"
                                BorderThickness="0" Background="Transparent" Foreground="White"
                                Click="MuteButton_Click" ToolTip="マイクをミュート">
                            <Viewbox Width="20" Height="20">
                                <Path x:Name="MuteIcon" Fill="White" Stretch="Uniform" Width="24" Height="24"
                                      Data="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3m5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="DeafenButton" Width="26" Height="26" Padding="0"
                                BorderThickness="0" Background="Transparent" Foreground="White"
                                Click="DeafenButton_Click" ToolTip="スピーカーをミュート">
                            <Viewbox Width="20" Height="20">
                                <Path x:Name="DeafenIcon" Fill="White" Stretch="Uniform" Width="24" Height="24"
                                      Data="M3 9v6h4l5 5V4L7 9zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02M14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock x:Name="WarningText" Visibility="Collapsed" TextAlignment="Center" FontSize="11"
                       Foreground="#D7D1DA" Margin="4,4,4,0" TextWrapping="Wrap" />
            <TextBlock x:Name="SecondWarningText" Visibility="Collapsed" TextAlignment="Center" FontSize="11"
                       Foreground="#D7D1DA" Margin="4,0,4,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="HeaderDivider" Grid.Row="2" Background="#5C565F" />

        <Grid x:Name="GameContent" Grid.Row="3">
            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Top" Margin="0,0,0,0"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="WaitingTitle" Text="Among Usを待っています" FontSize="20"
                           Margin="0,0,0,8" TextAlignment="Center" />
                <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,2">
                    <Path Data="M13,3.4 A18,18 0 0 1 27,3.4" Stroke="#AE70BB" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                <TextBlock x:Name="LaunchPresetLabel" Text="プリセット" FontSize="24" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,0,0,2" />
                <ComboBox x:Name="LaunchPlatformCombo" Visibility="Collapsed" DisplayMemberPath="Name"
                          SelectionChanged="LaunchPlatformCombo_SelectionChanged" />
                <Border x:Name="LaunchButtonGroup" MinWidth="142" Height="54" HorizontalAlignment="Center" BorderBrush="White"
                        BorderThickness="4" CornerRadius="10" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LaunchGameButton" Grid.Column="0" Content="Steam" FontSize="24"
                                MinWidth="96" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,0"
                                Click="LaunchGameButton_Click" />
                        <Border Grid.Column="1" Background="White" />
                        <Button x:Name="LaunchDropdownButton" Grid.Column="2" Foreground="White"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Click="LaunchDropdownButton_Click" ToolTip="起動先を選択">
                            <Path Fill="White" Data="M7 10l5 5 5-5z" Width="24" Height="24" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
                <Border x:Name="LaunchDropdownPanel" Visibility="Collapsed" Background="#272727"
                        BorderBrush="#666" BorderThickness="1" MinWidth="142"
                        Width="{Binding ActualWidth, ElementName=LaunchButtonGroup}" MaxHeight="110">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LaunchDropdownItems" />
                    </ScrollViewer>
                </Border>
                <Button x:Name="PublicLobbyButton" Content="公開ロビー" Margin="0,4,0,0"
                        Height="36" Padding="12,0" BorderBrush="#CE93D8" BorderThickness="1"
                        Background="Transparent" Foreground="#CE93D8"
                        Click="PublicLobbyButton_Click" />
            </StackPanel>
            <ScrollViewer x:Name="OtherPlayersScroll" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,4,0,0">
                <WrapPanel x:Name="OtherPlayersPanel" Width="225" HorizontalAlignment="Center" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4">
            <StackPanel x:Name="FooterBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button x:Name="GithubButton" Width="44" Height="36" Margin="4,0" ToolTip="GitHubのページはこちら"
                        Background="Transparent" BorderThickness="0" Foreground="#D0D0D0"
                        Click="GithubButton_Click">
                    <Viewbox Width="36" Height="36">
                        <Path Fill="White" Width="24" Height="24" Stretch="Uniform"
                              Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="DiscordButton" Width="44" Height="36" Margin="4,0" ToolTip="サポート用Discord"
                        Background="Transparent" BorderThickness="0" Foreground="#7289DA"
                        Click="DiscordButton_Click">
                    <Viewbox Width="36" Height="36">
                        <Canvas Width="245" Height="240">
                            <Path Fill="#7289DA" Data="M104.4 103.9c-5.7 0-10.2 5-10.2 11.1s4.6 11.1 10.2 11.1c5.7 0 10.2-5 10.2-11.1.1-6.1-4.5-11.1-10.2-11.1zM140.9 103.9c-5.7 0-10.2 5-10.2 11.1s4.6 11.1 10.2 11.1c5.7 0 10.2-5 10.2-11.1s-4.5-11.1-10.2-11.1z" />
                            <Path Fill="#7289DA" Data="M189.5 20h-134C44.2 20 35 29.2 35 40.6v135.2c0 11.4 9.2 20.6 20.5 20.6h113.4l-5.3-18.5 12.8 11.9 12.1 11.2 21.5 19V40.6c0-11.4-9.2-20.6-20.5-20.6zm-38.6 130.6s-3.6-4.3-6.6-8.1c13.1-3.7 18.1-11.9 18.1-11.9-4.1 2.7-8 4.6-11.5 5.9-5 2.1-9.8 3.5-14.5 4.3-9.6 1.8-18.4 1.3-25.9-.1-5.7-1.1-10.6-2.7-14.7-4.3-2.3-.9-4.8-2-7.3-3.4-.3-.2-.6-.3-.9-.5-.2-.1-.3-.2-.4-.3-1.8-1-2.8-1.7-2.8-1.7s4.8 8 17.5 11.8c-3 3.8-6.7 8.3-6.7 8.3-22.1-.7-30.5-15.2-30.5-15.2 0-32.2 14.4-58.3 14.4-58.3 14.4-10.8 28.1-10.5 28.1-10.5l1 1.2c-18 5.2-26.3 13.1-26.3 13.1s2.2-1.2 5.9-2.9c10.7-4.7 19.2-6 22.7-6.3.6-.1 1.1-.2 1.7-.2 6.1-.8 13-1 20.2-.2 9.5 1.1 19.7 3.9 30.1 9.6 0 0-7.9-7.5-24.9-12.7l1.4-1.6s13.7-.3 28.1 10.5c0 0 14.4 26.1 14.4 58.3 0 0-8.5 14.5-30.6 15.2z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="KofiButton" Width="44" Height="36" Margin="4,0" ToolTip="お賽銭で開発を支援する"
                        Background="Transparent" BorderThickness="0" Click="KofiButton_Click">
                    <Viewbox Width="36" Height="36">
                        <Canvas Width="48" Height="48">
                            <Ellipse Canvas.Left="19" Canvas.Top="2" Width="10" Height="10" Fill="#F6D46B" Stroke="#5B371F" StrokeThickness="1.5" />
                            <Path Data="M24,4 L24,10 M22,6 L26,6 M22,8 L26,8" Stroke="#5B371F" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M7,18 L13,13 L41,13 L44,18 L40,23 L11,23 Z" Fill="#B77B45" Stroke="#F4D5A0" StrokeThickness="2" StrokeLineJoin="Round" />
                            <Path Data="M7,18 L44,18 M13,13 L11,23 M21,13 L20,23 M29,13 L30,23 M40,13 L44,23" Stroke="#5B371F" StrokeThickness="2" />
                            <Path Data="M10,23 L41,23 L41,42 L10,42 Z" Fill="#8B562F" Stroke="#F4D5A0" StrokeThickness="2" />
                            <Path Data="M16,26 L16,39 M24,26 L24,39 M32,26 L32,39" Stroke="#BA8654" StrokeThickness="2" />
                            <Path Data="M20,19 L30,19" Stroke="#38241A" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="XButton" Width="44" Height="36" Margin="4,0" ToolTip="Xのページはこちら"
                        Background="Transparent" BorderThickness="0" Click="XButton_Click">
                    <Viewbox Width="36" Height="36">
                        <Path Fill="White" Width="36" Height="36" Stretch="Uniform"
                              Data="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="HelpButton" Width="44" Height="36" Margin="4,0" ToolTip="お問い合わせ"
                        Background="Transparent" BorderThickness="0" Foreground="#D0D0D0"
                        Click="HelpButton_Click">
                    <Grid Width="28" Height="28">
                        <Ellipse Fill="White" />
                        <TextBlock Text="?" Foreground="#25232A" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="ErrorPanel" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="2"
                    Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="264" Margin="8,0">
            <TextBlock Text="ERROR" Foreground="#F44336" FontSize="20"
                       TextAlignment="Center" Margin="0,0,0,8" />
            <TextBlock x:Name="ErrorMessage" TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="Need help?" VerticalAlignment="Center" />
                <Button Content="Get support" Click="ErrorSupportButton_Click"
                        Foreground="#CE93D8" Background="Transparent" Margin="4,0,8,0" />
                <Button Content="Reload" Click="ReloadButton_Click" Foreground="White"
                        Background="Transparent" BorderBrush="White" BorderThickness="2"
                        Padding="10,2" />
            </StackPanel>
        </StackPanel>
        <Border x:Name="DetectedModBadge" Grid.RowSpan="5" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,0,6,58"
                MaxWidth="268" Padding="5,2" CornerRadius="4" Background="#59000000"
                IsHitTestVisible="False">
            <TextBlock x:Name="DetectedMod" FontSize="10" Foreground="#B8B8B8"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </Border>
        <Popup x:Name="PlayerConfigPopup" Placement="Top" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="Fade" IsOpen="False">
            <Border x:Name="PlayerConfigPopupContent" Background="#353239" BorderBrush="#68616C"
                    BorderThickness="1" CornerRadius="4" Padding="9,6"
                    MouseEnter="PlayerConfigPopup_MouseEnter" MouseLeave="PlayerConfigPopup_MouseLeave">
                <StackPanel>
                    <TextBlock x:Name="PlayerConfigName" TextAlignment="Center" FontWeight="Bold"
                               MaxWidth="175" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                        <Button x:Name="PlayerMuteButton" Width="30" Height="30" Background="Transparent"
                                Click="PlayerMuteButton_Click" ToolTip="このプレイヤーをミュート">
                            <Viewbox Width="20" Height="20">
                                <Path x:Name="PlayerMuteIcon" Fill="#CE93D8" Width="24" Height="24"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>
                        <Slider x:Name="PlayerVolumeSlider" Width="118" Minimum="0" Maximum="2"
                                TickFrequency="0.02" IsSnapToTickEnabled="True" SmallChange="0.02"
                                LargeChange="0.1" IsMoveToPointEnabled="True" Value="1" Margin="4,0,0,0"
                                ValueChanged="PlayerVolumeSlider_ValueChanged"
                                PreviewMouseLeftButtonUp="PlayerVolumeSlider_MouseLeftButtonUp"
                                KeyUp="PlayerVolumeSlider_KeyUp" />
                        <TextBlock x:Name="PlayerVolumeText" Width="40" Text="100%"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
