<UserControl x:Class="TanukiBCL.Client.InquiryForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#25232A" Foreground="#F5F1F7">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsControlResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="InquiryFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="BorderBrush" Value="#817A84" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CaretBrush" Value="#CE93D8" />
            <Setter Property="SelectionBrush" Value="#BA68C8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#CE93D8" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InquiryComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#25232A" />
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="BorderBrush" Value="#817A84" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#25232A" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="12,8" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#49374E" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="14,0,2,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path Grid.Column="1" Data="M7 10l5 5 5-5z" Fill="#F5F1F7"
                                          Width="20" Height="20" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#25232A" BorderBrush="#817A84" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryActionStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="BorderBrush" Value="#F44336" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#49464C" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#49464C" />
                                <Setter Property="Foreground" Value="#918C95" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquirySendStyle" TargetType="Button" BasedOn="{StaticResource InquiryActionStyle}">
            <Setter Property="Background" Value="#F44336" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="InquiryTextActionStyle" TargetType="Button" BasedOn="{StaticResource InquiryActionStyle}">
            <Setter Property="Foreground" Value="#CE93D8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="InquiryConsentStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F1F7" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="42">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="CheckSurface" Width="18" Height="18" CornerRadius="2" BorderBrush="#B7AABD" BorderThickness="2">
                                <Path x:Name="CheckMark" Data="M2 7 L5.5 10.5 L12 3.5" Stroke="#25232A" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#BA68C8" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#BA68C8" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#CE93D8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="InquiryLayout" Background="#25232A" HorizontalAlignment="Center" MaxWidth="752"
          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="FormScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Loaded="FormScrollViewer_Loaded">
            <StackPanel x:Name="FormFields" Margin="0,8">
                <TextBlock Text="問い合わせ" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border x:Name="ResultBanner" Visibility="Collapsed" CornerRadius="4" Padding="12"
                        BorderThickness="1" Margin="0,0,0,16">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="14" />
                </Border>
                <Button x:Name="IssueLinkButton" Visibility="Collapsed" HorizontalAlignment="Left"
                        Style="{StaticResource InquiryTextActionStyle}" Click="IssueLinkButton_Click"
                        Margin="0,0,0,12" />
                <Border Background="#4B351D" BorderBrush="#A87935" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20"
                               Text="送信すると、件名・本文・選択した添付ファイル・自動添付ログが、この.NET版の公開GitHub IssueとDiscordフォーラムに掲載されます。個人情報や秘密情報が含まれていないか確認してください。" />
                </Border>
                <ComboBox x:Name="TagCombo" Height="56" SelectedIndex="0" Margin="0,0,0,8"
                          Style="{StaticResource InquiryComboStyle}">
                    <ComboBoxItem Content="質問" Tag="question" />
                    <ComboBoxItem Content="不具合" Tag="bug" />
                    <ComboBoxItem Content="要望" Tag="request" />
                </ComboBox>
                <Grid Margin="0,0,0,8" Height="56">
                    <TextBox x:Name="SubjectBox" Height="56" MaxLength="100" Padding="12,12" VerticalContentAlignment="Center"
                             Style="{StaticResource InquiryFieldStyle}"
                             TextChanged="Input_Changed" GotKeyboardFocus="Field_FocusChanged"
                             LostKeyboardFocus="Field_FocusChanged" />
                    <TextBlock x:Name="SubjectLabel" Text="件名" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Foreground="#B7AABD" />
                </Grid>
                <Grid Margin="0,0,0,8" Height="112">
                    <TextBox x:Name="BodyBox" MinHeight="112" MaxLength="1800" Padding="12,10"
                             Style="{StaticResource InquiryFieldStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="Input_Changed" GotKeyboardFocus="Field_FocusChanged"
                             LostKeyboardFocus="Field_FocusChanged" />
                    <TextBlock x:Name="BodyLabel" Text="本文" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Foreground="#B7AABD" />
                </Grid>
                <Button x:Name="SelectFilesButton" HorizontalAlignment="Left"
                        Style="{StaticResource InquiryActionStyle}" Click="SelectFilesButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5S13.5 3.62 13.5 5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="添付ファイルを選択" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="AttachmentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinHeight="32">
                                <Button DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveFileButton_Click"
                                        Width="32" Height="32" Padding="5" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="#B7AABD" BorderThickness="0" ToolTip="削除">
                                    <Path Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z"
                                          Fill="#B7AABD" Stretch="Uniform" />
                                </Button>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#3D3942" BorderThickness="0,1,0,0" Padding="0,12">
            <StackPanel>
                <CheckBox x:Name="PublicIssueConsentBox" Content="公開される内容を確認しました"
                          Style="{StaticResource InquiryConsentStyle}" Margin="0,0,0,8"
                          Checked="PublicIssueConsentBox_Changed" Unchecked="PublicIssueConsentBox_Changed" />
                <Button x:Name="SendButton" IsEnabled="False" HorizontalAlignment="Right"
                        Style="{StaticResource InquirySendStyle}" Click="SendButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="送信" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
