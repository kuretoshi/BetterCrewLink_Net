                                        <TextBlock x:Name="ImpostorRadioShortcutLabel" Text="インポスターラジオ" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBox x:Name="ImpostorRadioShortcutBox" Grid.Column="1" IsReadOnly="True"
                                                 Style="{StaticResource ShortcutFieldStyle}"
                                                 GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                                                 PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3F3944" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MuteShortcutLabel" Text="ミュート" FontWeight="SemiBold" />
                                        <TextBox x:Name="MuteShortcutBox" Grid.Column="1" IsReadOnly="True"
                                                 Style="{StaticResource ShortcutFieldStyle}"
                                                 GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                                                 PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DeafenShortcutLabel" Text="スピーカーミュート" FontWeight="SemiBold" />
                                        <TextBox x:Name="DeafenShortcutBox" Grid.Column="1" IsReadOnly="True"
                                                 Style="{StaticResource ShortcutFieldStyle}"
                                                 GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                                                 PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                                                 PreviewMouseDown="ShortcutBox_PreviewMouseDown" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="OverlayPanel" Visibility="Collapsed">
                        <TextBlock Text="オーバーレイ" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,8" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="OverlayAlwaysOnTopCheck" Content="常に手前に表示"
                                              Style="{StaticResource OverlaySwitchStyle}" />
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="EnableOverlayCheck" Content="ゲーム画面にオーバーレイを表示"
                                              Style="{StaticResource OverlaySwitchStyle}" />
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="CompactOverlayCheck" Content="発話中のプレイヤーだけを表示"
                                              Style="{StaticResource OverlaySwitchStyle}"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableOverlayCheck}" />
                                </Border>
                                <Border Padding="16,10" BorderBrush="#3C3741" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="MeetingOverlayCheck" Content="会議中の発話枠を表示"
                                              Style="{StaticResource OverlaySwitchStyle}"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableOverlayCheck}" />
                                </Border>
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="アバターの位置" VerticalAlignment="Center" />
                                    <ComboBox x:Name="OverlayPositionCombo" Grid.Column="1"
                                              IsEnabled="{Binding IsChecked, ElementName=EnableOverlayCheck}">
                                        <ComboBoxItem Content="表示しない" Tag="hidden" />
                                        <ComboBoxItem Content="上" Tag="top" />
                                        <ComboBoxItem Content="左下" Tag="bottom_left" />
                                        <ComboBoxItem Content="右" Tag="right" />
                                        <ComboBoxItem Content="右（発話中に名前表示）" Tag="right1" />
                                        <ComboBoxItem Content="左" Tag="left" />
                                        <ComboBoxItem Content="左（発話中に名前表示）" Tag="left1" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <TextBlock Text="詳細設定" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,14" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="ボイスサーバー" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ServerUrlBox" Grid.Column="1" IsEditable="False" MinHeight="34"
                                              SelectionChanged="ServerUrlBox_SelectionChanged" />
                                </Grid>
                                <Border Height="1" Background="#403A45" />
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock x:Name="NatFixLabel" Text="NATの修正" FontWeight="SemiBold" />
                                        <TextBlock Text="P2Pの代わりにTURNサーバーを経由します。接続の問題を解決できますが、遅延が増える場合があります。"
                                                   TextWrapping="Wrap" Foreground="#A8A4B0" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="NatFixCheck" Grid.Column="1" Style="{StaticResource OverlaySwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="#403A45" />
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="ボイスサーバー" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ServerUrlDescription" Foreground="#B7AABD" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button x:Name="ChangeServerButton" Grid.Column="1" Content="ボイスサーバーの変更"
                                            Background="#F44336" Foreground="White" Padding="10,6"
                                            VerticalAlignment="Center" Click="ChangeServerButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="デバッグ" FontSize="12" Foreground="#B7AABD" Margin="4,24,0,14" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1" CornerRadius="8">
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="デバッグ情報" FontWeight="SemiBold" />
                                    <TextBlock Text="ゲーム状態や音声接続を診断表示で確認します。"
                                               Foreground="#B7AABD" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="OpenDebugButton" Grid.Column="1" Content="デバッグ情報を開く"
                                        VerticalAlignment="Center" Padding="10,6" Click="OpenDebugButton_Click" />
                            </Grid>
                        </Border>
                        <TextBlock Text="ベータ/デバッグ" FontSize="12" Foreground="#B7AABD" Margin="4,24,0,14" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <CheckBox x:Name="MobileHostCheck" Content="モバイル ホスト" Margin="16,12" />
                                <Border Height="1" Background="#403A45" />
                                <StackPanel Margin="16,12">
                                    <CheckBox x:Name="HardwareAccelerationCheck" Content="ハードウェア アクセラレーション" />
                                    <TextBlock Text="ハードウェアアクセラレーションを無効にします（CPU使用率が上がる可能性があります）"
                                               TextWrapping="Wrap" Foreground="#B7AABD" FontSize="12" Margin="20,4,0,0" />
                                </StackPanel>
                                <Border Height="1" Background="#403A45" />
                                <CheckBox x:Name="EchoCancellationCheck" Content="エコーキャンセラー" Margin="16,12" />
                                <Border Height="1" Background="#403A45" />
                                <StackPanel Margin="16,12">
                                    <CheckBox x:Name="AutoGainControlCheck" Content="自動ゲイン調整"
                                              Checked="AutoGainControlCheck_Changed" Unchecked="AutoGainControlCheck_Changed" />
                                    <TextBlock Text="ベータ版：マイク音量を自動調整します。先にテストしてください。"
                                               TextWrapping="Wrap" Foreground="#A8A4B0" FontSize="12" Margin="20,4,0,0" />
                                </StackPanel>
                                <Border Height="1" Background="#403A45" />
                                <StackPanel Margin="16,12">
                                    <CheckBox x:Name="SpatialAudioCheck" Content="立体音響" />
                                    <TextBlock Text="OFFでも声が届く距離や壁の遮断は有効です。距離内の音量と左右配置を固定します。"
                                               TextWrapping="Wrap" Foreground="#A8A4B0" FontSize="12" Margin="20,4,0,0" />
                                </StackPanel>
                                <Border Height="1" Background="#403A45" />
                                <CheckBox x:Name="NoiseSuppressionCheck" Content="ノイズ防止" Margin="16,12" />
                                <Border Height="1" Background="#403A45" />
                                <StackPanel Margin="16,12">
                                    <CheckBox x:Name="OldSampleDebugCheck" Content="サンプルレートデバッグ" />
                                    <TextBlock Text="依頼された場合のみ有効にするテスト機能です。ONではマイク入力を48 kHzで要求します。"
                                               TextWrapping="Wrap" Foreground="#A8A4B0" FontSize="12" Margin="20,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="UpdatePanel" Visibility="Collapsed">
                        <TextBlock Text="アップデート" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,14" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1"
                                Padding="20,22,20,22" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" FontSize="15" FontWeight="Medium"
                                           Visibility="Collapsed" Margin="0,0,0,6" />
                                <TextBlock x:Name="UpdateStatusText" Text="アップデートを確認してください。"
                                           FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,22" />
                                <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="100"
                                             Visibility="Collapsed" Margin="0,0,0,20" />
                                <WrapPanel MaxWidth="440" HorizontalAlignment="Left">
                                    <Button x:Name="CheckUpdateButton" Content="アップデートを確認"
                                            Style="{StaticResource UpdateActionButtonStyle}" Margin="0,0,12,8"
                                            Click="CheckUpdateButton_Click" />
                                    <Button x:Name="StartUpdateButton" Content="アップデート開始"
                                            Style="{StaticResource UpdateFilledButtonStyle}" Margin="0,0,0,8"
                                            IsEnabled="False" Click="StartUpdateButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="アップデート開始後は、ダウンロード完了時にアプリを終了して更新します。"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#E8E1EA"
                                           TextWrapping="Wrap" Margin="0,11,0,0" />
                                <Button x:Name="ManualUpdateDownloadButton" Content="手動でダウンロード"
                                        HorizontalAlignment="Left" Padding="14,8" Margin="0,8,0,0"
                                        Visibility="Collapsed" Click="ManualUpdateDownloadButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="StreamingPanel" Visibility="Collapsed">
                        <TextBlock Text="配信設定" FontSize="12" Foreground="#B7AABD" Margin="4,0,0,14" />
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Padding="16,5" BorderBrush="#3F3944" BorderThickness="0,0,0,1">
                                    <CheckBox x:Name="ShowLobbyCodeCheck" Content="ロビーコードの表示"
                                              Style="{StaticResource OverlaySwitchStyle}" FontSize="14" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="ObsToggleBorder" Padding="16,5" BorderBrush="#3F3944">
                                    <CheckBox x:Name="ObsOverlayCheck" Content="OBS ブラウザーのオーバーレイ"
                                              Style="{StaticResource OverlaySwitchStyle}" FontSize="14" FontWeight="SemiBold"
                                              Checked="ObsOverlayCheck_Changed" Unchecked="ObsOverlayCheck_Changed" />
                                </Border>
                                <StackPanel x:Name="ObsUrlPanel" Visibility="Collapsed" Margin="16,10,16,16">
                                    <TextBlock Text="OBSブラウザソースURL" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid>
                                        <TextBox x:Name="ObsUrlBox" IsReadOnly="True" Height="40"
                                                 Padding="10,7,44,7" Background="#25232A" Foreground="#F5F1F7" FontSize="14"
                                                 BorderBrush="#5A515D" />
                                        <Button x:Name="CopyObsUrlButton" Width="36" Height="36" Padding="8"
                                                Margin="0,2,2,2" HorizontalAlignment="Right"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip="URLをコピー" Click="CopyObsUrlButton_Click">
                                            <Path x:Name="CopyObsUrlIcon" Fill="#B7AABD" Stretch="Uniform"
                                                  Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="SaveStatusText" Visibility="Collapsed" VerticalAlignment="Bottom"
                       Background="#40202A" Foreground="IndianRed" Padding="12,8"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
        <Grid x:Name="ServerDialogBackdrop" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed"
              MouseDown="ServerDialogBackdrop_MouseDown">
            <local:ServerUrlDialog x:Name="ServerDialog" Margin="32" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="ConfirmDialogBackdrop" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed"
              MouseDown="ConfirmDialogBackdrop_MouseDown">
            <local:SettingsConfirmDialog x:Name="ConfirmDialog" Margin="32" VerticalAlignment="Center" />
        </Grid>
        </Grid>
    </Grid>
</Window>
