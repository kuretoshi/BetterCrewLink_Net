                                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="10,0"
                                            IsEnabled="{Binding IsChecked, ElementName=MicSensitivityCheck}"
                                            ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="MicSensitivityValue" Grid.Column="3" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#2A2630" BorderBrush="#3F3944" BorderThickness="1"
                                CornerRadius="8" Margin="0,24,0,0">
                            <StackPanel>
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="マスターボリューム" FontWeight="SemiBold" />
                                    <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Minimum="0" Maximum="200"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0"
